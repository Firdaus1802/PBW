{
  "version": 2,
  "framework": null,
  "buildCommand": null,
  "outputDirectory": null,
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.4"
    }
  },
  "routes": [
    {
      "src": "/m6/assets/(.*)",
      "dest": "/m6/assets/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/m6/assets/$1"
    },
    {
      "src": "/manifest.json",
      "dest": "/m6/manifest.json"
    },
    {
      "src": "/favicon.ico",
      "dest": "/m6/assets/icons/app-icon.png"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
